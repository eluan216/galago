# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://uqqxtdrjjvmzfqoycpdt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# VTpass (start with sandbox credentials)
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_ENVIRONMENT=sandbox

# eSIM Access has no sandbox environment. Keep purchases disabled until live
# access, provider test funds, and a live-order test are explicitly approved.
ESIM_ACCESS_CODE=
ESIM_ACCESS_PURCHASES_ENABLED=false

# Frankfurter provides free commercial-use reference rates; no API key required.

# NOWPayments (crypto)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret

# Paystack (fiat)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Owlet SMM fulfillment (server-only)
# Key from Owlet Developers page. Fund the Owlet wallet — API orders debit it.
OWLET_API_KEY=
OWLET_API_URL=https://theowlet.com/api/v2
OWLET_ENABLED=false
